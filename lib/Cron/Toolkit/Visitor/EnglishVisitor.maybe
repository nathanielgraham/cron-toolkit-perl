package Cron::Toolkit::Visitor::EnglishVisitor;
use strict;
use warnings;
use parent 'Cron::Toolkit::Visitor';
use Cron::Toolkit::Utils qw(
   num_to_ordinal format_time %month_names %day_names
   join_parts field_unit
);

sub new {
   my ($class, %args) = @_;
   my $self = $class->SUPER::new(%args);
   $self->{field_order} = [qw(second minute hour dom month dow year)];
   return $self;
}

sub visit {
   my ($self, $node, @child_results) = @_;
   my $type = $node->{type} // '';
   return $self->_fuse($node) if $type eq 'root';
   return $node;
}

sub _fuse {
   my ($self, $root) = @_;
   my @fields = @{ $root->{children} };
   my (@time_data, @date_data);

   for my $i (0 .. 6) {
      my $field = $self->{field_order}[$i];
      my $node  = $fields[$i];
      my $data  = $self->_render_data($node, $field);
      next unless $data;
      ($i <= 2 ? \@time_data : \@date_data)->@* = $data;
   }

   my $time = $self->_join_time(@time_data);
   my $date = $self->_join_date(@date_data);

   return $time if $time && !$date;
   return $date if $date && !$time;
   return "$time, $date" if $time && $date;
   return "every minute";
}

# ————————————————————
# RENDER: DATA-ONLY
# ————————————————————
sub _render_data {
   my ($self, $node, $field) = @_;
   return undef unless $node;
   my $type = $node->{type};

   if ($type eq 'single') {
      my $v = $node->{value};
      return undef if $v == 0 && $field =~ /^(second|minute|hour)$/;
      return { field => $field, value => $v, kind => 'value' };
   }
   if ($type eq 'wildcard') {
      return { field => $field, value => "every $field", kind => 'context' }
         if $field =~ /^(minute|hour)$/;
      return undef;
   }
   if ($type eq 'range') {
      my ($s, $e) = map { $_->{value} } @{$node->{children}};
      return { field => $field, value => [$s, $e], kind => 'range' };
   }
   if ($type eq 'list') {
      my @values;
      for my $c (@{$node->{children}}) {
         push @values, $c->{value} if $c->{type} eq 'single';
         if ($c->{type} eq 'range') {
            my ($s, $e) = map { $_->{value} } @{$c->{children}};
            push @values, $s, $e if defined $s && defined $e;
         }
         if ($c->{type} eq 'step') {
            my ($base, $step_node) = @{$c->{children}};
            push @values, $self->_expand_step($base, $step_node->{value}, $field);
         }
      }
      return { field => $field, value => \@values, kind => 'list' };
   }
   if ($type eq 'step') {
      my ($base, $step_node) = @{$node->{children}};
      my @vals = $self->_expand_step($base, $step_node->{value}, $field);
      return { field => $field, value => \@vals, kind => 'list' };
   }
   return undef;
}

sub _expand_step {
   my ($self, $base, $step, $field) = @_;
   my ($min, $max) = @{ $Cron::Toolkit::Utils::LIMITS{$field} };
   my @out;
   if ($base->{type} eq 'wildcard') {
      for (my $v = $min; $v <= $max; $v += $step) { push @out, $v; }
   } elsif ($base->{type} eq 'single') {
      my $s = $base->{value};
      $s = $min if $s < $min;
      for (my $v = $s; $v <= $max; $v += $step) { push @out, $v; }
   } elsif ($base->{type} eq 'range') {
      my ($s, $e) = map { $_->{value} } @{$base->{children}};
      $s = $min if $s < $min;
      $e = $max if $e > $max;
      for (my $v = $s; $v <= $e; $v += $step) { push @out, $v; }
   }
   return @out;
}

# ————————————————————
# JOIN: TIME
# ————————————————————

sub _join_time {
   my ($self, @data) = @_;
   my $result = '';

   # --- SECOND ---
   my ($sec) = map { $_->{value} }
               grep { $_->{field} eq 'second' && $_->{kind} eq 'value' } @data;
   my ($sec_step) = grep { $_->{field} eq 'second' && $_->{kind} eq 'list' } @data;

   if ($sec_step) {
      my @s = @{$sec_step->{value}};
      my $step = @s > 1 ? $s[1] - $s[0] : 1;
      $result .= "every $step second" . ($step == 1 ? '' : 's');
   } elsif ($sec) {
      $result .= "$sec second" . ($sec == 1 ? '' : 's') . " past every minute";
   }

   # --- MINUTE ---
   my $every_min = grep { /every minute/ }
                   map  { $_->{value} }
                   grep { $_->{kind} eq 'context' } @data;
   my ($min_step) = grep { $_->{field} eq 'minute' && $_->{kind} eq 'list' } @data;
   my ($min_range) = grep { $_->{field} eq 'minute' && $_->{kind} eq 'range' } @data;

   if ($min_step) {
      my @m = @{$min_step->{value}};
      my $step = @m > 1 ? $m[1] - $m[0] : 1;
      $result = "every $step minute" . ($step == 1 ? '' : 's') . ($result ? " $result" : '');
   } elsif ($min_range) {
      my ($s, $e) = @{$min_range->{value}};
      $result = "from $s to $e minute" . ($e == 1 ? '' : 's') . ($result ? " $result" : '');
   } elsif ($every_min) {
      $result = 'every minute' . ($result ? " $result" : '');
   }

   # --- HOUR ---
   my ($hour_list) = grep { $_->{field} eq 'hour' && $_->{kind} eq 'list' } @data;
   if ($hour_list) {
      my @h = sort { $a <=> $b } @{$hour_list->{value}};
      my @ranges;
      my $i = 0;
      while ($i < @h) {
         my $s = $h[$i];
         my $e = $s;
         while ($i + 1 < @h && $h[$i + 1] == $e + 1) { $i++; $e++; }
         my $from = format_time(0, 0,  $s, { omit_seconds_if_zero => 1 });
         my $to   = format_time(0, 59, $e, { omit_seconds_if_zero => 1 });
         push @ranges, $s == $e ? $from : "$from to $to";
         $i++;
      }
      $result .= " between " . join(" and ", @ranges);
   }

   # --- CONCRETE TIME (only if no list/step) ---
   my ($h_val) = map { $_->{value} }
                 grep { $_->{field} eq 'hour'   && $_->{kind} eq 'value' } @data;
   my ($m_val) = map { $_->{value} }
                 grep { $_->{field} eq 'minute' && $_->{kind} eq 'value' } @data;
   if (!$hour_list && !$min_step && !$min_range && ($h_val || $m_val || $sec)) {
      my $t = format_time($sec||0, $m_val||0, $h_val||0, { omit_seconds_if_zero => 1 });
      $result .= " at $t";
   }

   return $result;
}

# ————————————————————
# JOIN: DATE
# ————————————————————
sub _join_date {
   my ($self, @data) = @_;
   my @parts;

   for my $d (@data) {
      next if $d->{field} =~ /^(second|minute|hour)$/;

      # DOM step → every Nth day
      if ($d->{field} eq 'dom' && $d->{kind} eq 'list') {
         my @days = @{$d->{value}};
         if (@days && $days[0] == 1 && @days >= 10) {
            my $step = $days[1] - $days[0];
            if ($step > 0 && @days == int(30/$step)+1) {
               push @parts, "every $step" .
                  ($step==1?'st':$step==2?'nd':$step==3?'rd':'th') .
                  " day of the month";
               next;
            }
         }
      }

      push @parts, $self->_render_value($d);
   }
   return join ", ", @parts;
}

# ————————————————————
# RENDER: VALUE FROM DATA
# ————————————————————
sub _render_value {
   my ($self, $d) = @_;
   return "" unless $d && exists $d->{kind};

   if ($d->{kind} eq 'value') {
      return "" if $d->{value} == 0;
      return "$d->{value} second" . ($d->{value} > 1 ? "s" : "") if $d->{field} eq 'second';
      return "$d->{value} minute" . ($d->{value} > 1 ? "s" : "") if $d->{field} eq 'minute';
      return format_time(0, 0, $d->{value}, { omit_seconds_if_zero => 1 }) if $d->{field} eq 'hour';
      return num_to_ordinal($d->{value}) if $d->{field} eq 'dom';
      return $month_names{$d->{value}} // $d->{value} if $d->{field} eq 'month';
      return $day_names{$d->{value}}   // $d->{value} if $d->{field} eq 'dow';
      return $d->{value};
   }

   if ($d->{kind} eq 'range') {
      my ($s, $e) = @{$d->{value}};
      if ($d->{field} eq 'hour') {
         my $from = format_time(0, 0, $s, { omit_seconds_if_zero => 1 });
         my $to   = format_time(0, 0, $e, { omit_seconds_if_zero => 1 });
         return "$from to $to";
      }
      my $from = $self->_render_value({ field => $d->{field}, value => $s, kind => 'value' });
      my $to   = $self->_render_value({ field => $d->{field}, value => $e, kind => 'value' });
      return "$from to $to";
   }

   if ($d->{kind} eq 'list') {
      my @items = map { $self->_render_value({ field => $d->{field}, value => $_, kind => 'value' }) }
                  @{$d->{value}};
      return join_parts(@items);
   }

   if ($d->{kind} eq 'step') {
      my $base = $d->{base};
      my $step = $d->{step};
      if ($d->{field} eq 'dom') {
         return "every " . num_to_ordinal($step) . " day of the month";
      }
      return "every $step " . ($step > 1 ? "$d->{field}s" : $d->{field});
   }

   if ($d->{kind} eq 'last') {
      return $d->{value}
         ? num_to_ordinal($d->{value}) . " to last day of every month"
         : "last day of every month";
   }
   if ($d->{kind} eq 'lastW') { return "last weekday of every month"; }
   if ($d->{kind} eq 'nearest_weekday') {
      return "nearest weekday to the " . num_to_ordinal($d->{value}) . " of every month";
   }
   if ($d->{kind} eq 'nth') {
      return "on the " . num_to_ordinal($d->{nth}) .
             " " . ($day_names{$d->{dow}} // $d->{dow}) . " of every month";
   }

   return "";
}

1;
